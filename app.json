{
  "expo": {
    "name": "efektif-quran",
    "slug": "efektif-quran",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Efektif Quran",
      "shortName": "Quran",
      "description": "A beautiful Quran reader app with full-screen verse display",
      "lang": "en",
      "themeColor": "#0a1628",
      "backgroundColor": "#0a1628"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
