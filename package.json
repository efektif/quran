{
  "name": "efektif-quran",
  "version": "1.0.0",
  "packageManager": "bun@1.3.5",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web && cp -r public/* dist/ 2>/dev/null || true",
    "build:web": "expo export --platform web && cp -r public/* dist/ 2>/dev/null || true",
    "preview": "wrangler pages dev dist",
    "deploy": "wrangler pages deploy dist --project-name=efektif-quran",
    "deploy:prod": "wrangler pages deploy dist --project-name=efektif-quran --branch=main",
    "clean": "rm -rf dist .expo",
    "cf:login": "wrangler login",
    "cf:init": "wrangler pages project create efektif-quran --production-branch=main"
  },
  "dependencies": {
    "@efektif/native": "^0.2.2",
    "@efektif/tokens": "^2.0.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.10.1",
    "expo": "~54.0.31",
    "expo-adapter-workers": "^1.0.4",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "wrangler": "^4.61.0"
  },
  "overrides": {
    "@efektif/tokens": "^2.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6",
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2",
    "wrangler": "^3.99.0"
  },
  "private": true
}
