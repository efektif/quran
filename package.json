{
  "name": "efektif-quran",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/serve-static.mjs",
    "deploy": "next build && pnpm exec wrangler pages deploy out --project-name ${CLOUDFLARE_PAGES_PROJECT:-efektif-quran}",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "test:unit": "vitest run src",
    "test:e2e": "playwright test",
    "data:fetch": "tsx scripts/fetch-quran-data.ts",
    "test": "pnpm test:unit",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify:full": "pnpm verify && pnpm test:e2e"
  },
  "dependencies": {
    "@masaajid/prayer-times": "^1.0.1",
    "next": "16.3.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "adhan": "^4.4.4",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.5",
    "wrangler": "^4.61.0"
  },
  "packageManager": "pnpm@11.5.0"
}
