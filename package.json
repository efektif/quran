{
  "name": "efektif-quran",
  "version": "1.0.0",
  "packageManager": "bun@1.3.5",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "deploy": "expo export --platform web && bunx wrangler pages deploy dist --project-name ${CLOUDFLARE_PAGES_PROJECT:-efektif-quran}",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt ."
  },
  "dependencies": {
    "@efektif/native": "^0.2.2",
    "@efektif/tokens": "^2.0.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "expo": "~54.0.36",
    "expo-constants": "~18.0.13",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "wrangler": "^4.61.0"
  },
  "overrides": {
    "@efektif/tokens": "^2.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6",
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0"
  },
  "private": true
}
