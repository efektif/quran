{"number":114,"name":"سُورَةُ النَّاسِ","englishName":"An-Naas","englishNameTranslation":"Mankind","numberOfAyahs":6,"revelationType":"Meccan","startPage":604,"ayahs":[{"number":6231,"numberInSurah":1,"text":"قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","translationId":"Katakanlah, \"Aku berlindung kepada Tuhannya manusia,","translationEn":"Say, \"I seek refuge in the Lord of mankind,","juz":30,"page":604,"hizbQuarter":240},{"number":6232,"numberInSurah":2,"text":"مَلِكِ ٱلنَّاسِ","translationId":"Raja manusia,","translationEn":"The Sovereign of mankind.","juz":30,"page":604,"hizbQuarter":240},{"number":6233,"numberInSurah":3,"text":"إِلَٰهِ ٱلنَّاسِ","translationId":"sembahan manusia,","translationEn":"The God of mankind,","juz":30,"page":604,"hizbQuarter":240},{"number":6234,"numberInSurah":4,"text":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","translationId":"dari kejahatan (bisikan) setan yang bersembunyi,","translationEn":"From the evil of the retreating whisperer -","juz":30,"page":604,"hizbQuarter":240},{"number":6235,"numberInSurah":5,"text":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","translationId":"yang membisikkan (kejahatan) ke dalam dada manusia,","translationEn":"Who whispers [evil] into the breasts of mankind -","juz":30,"page":604,"hizbQuarter":240},{"number":6236,"numberInSurah":6,"text":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","translationId":"dari (golongan) jin dan manusia.\"","translationEn":"From among the jinn and mankind.\"","juz":30,"page":604,"hizbQuarter":240}]}